#!/bin/bash

# ==============================================================================
# GSIRW - OPTIMIZED & FULLY RESTORED
# ==============================================================================

# --- Variables Globales y Configuración Visual ---

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Variable oculta para redirigir outputs molestos
hider="/dev/null"
[ "$DEBUG" = "true" ] && hider="/dev/stdout"

export LOGO='
----------------------------------------------------
|           ____ ____ ___                          |
|         / ___/ ___|_ _|     _ ____      __       |
|        | |  _\___ \| |_____|  __\ \ /\ / /       |
|        | |_| |___) | |_____| |   \ V  V /        |
|         \____|____/___|    |_|    \_/\_/         |
|                 _     ___    ___                 |
|                /_\   |_ _|  / _ \                |
|               / _ \   | |  | (_) |               |
|              /_/ \_\ |___|  \___/                |
|                                                  |
|           Made by: TheDarkDeath788               |
|                                                  |
|   If u get any bug, im not responsable, you can  |
|      try to make a issue on "e2fsprogs" repo     |
----------------------------------------------------
'

# Decodificación segura de LOGOV2
if command -v base64 >/dev/null; then
    LOGOV2="$(echo "CiguIFkgLikKKSAgICgKKCAgICAgKQo==" | base64 -d 2>/dev/null)"
else
    LOGOV2="(  Y  )\n)   (\n(     )"
fi

# --- Funciones de Utilidad (Optimizadas) ---

function generate_date_message() {
    printf -v hour "%(%Hhs:%Mmin)T" -1
    printf -v date_str "%(%dday|%mmon|%Yyear)T" -1
    day="[$hour]($date_str)"
}

function clear_screen() {
    printf '\033c'
}

function get_term_width() {
    local cols=$(tput cols 2>/dev/null)
    if [ -z "$cols" ]; then
        cols=$(stty size 2>/dev/null | awk '{print $2}')
    fi
    echo "${cols:-80}"
}

function center_ansi() {
    local text="$1"
    local width=$(get_term_width)
    echo "$text" | awk -v w="$width" '{
        len = length($0)
        if (len < w) padding = int((w - len) / 2)
        else padding = 0
        printf "%*s%s\n", padding, "", $0
    }'
}

function print_justified() {
    local text="$1"
    local width=$(get_term_width)
    local len=${#text}
    local padding=$(( (width - len) / 2 ))
    [ $padding -lt 0 ] && padding=0
    printf "%${padding}s%s\n" "" "$text"
}

function progressive_print() {
    local text="$1"
    local delay="${2:-0.05}"
    if [ "$ANIMATION" != "true" ]; then echo "$text"; return; fi
    local len=${#text}
    for (( i=0; i<len; i++ )); do
        printf "%s" "${text:$i:1}"
        sleep "$delay"
    done
    echo ""
}

function sleepy() {
    [ "$ANIMATION" = "true" ] && sleep "$1"
}

function ask() {
    echo ""
    print_justified "Press any key to continue..."
    read -rsn1
}

function prompt_for_confirmation() {
    local msg="$1"
    echo "$msg"
    read -rsn1
}

# --- Configuración Core ---

function default() {
    DEFAULT_SYSTEM_NAME="system"
    DEFAULT_VENDOR_NAME="vendor"
    DEFAULT_PRODUCT_NAME="product"
    DEFAULT_ODM_NAME="odm"
    
    : "${CUSTOM_SYSTEM_NAME:=system}"
    : "${CUSTOM_VENDOR_NAME:=vendor}"
    : "${CUSTOM_PRODUCT_NAME:=product}"
    : "${CUSTOM_ODM_NAME:=odm}"
    
    : "${CUSTOM_MOUNT_POINT:=/cache/system}"
    : "${DEFAULT_START_POINT:=/sdcard}"
    : "${MOUSE:=>}"
    : "${UP_SHORTCUTS:=true}"
    : "${SORT_DIR_TYPE:=name_asc}" # Mantenido por compatibilidad, aunque el explorador optimizado usa orden natural
    
    FILE_EXTENSIONS="|img|gzip|xz|tar|zip|gz|bz2|lz4|7z|rar|Z|"
    
    # Formato limpio para shortcuts
    SHORTCUTS="DATA /data
SDCARD /sdcard"
    
    identify_device
}

function identify_device() {
    [[ -n "$DYNAMIC" && -n "$A_B" ]] && return 0

    if [ -d "/dev/block/mapper" ]; then
        DYNAMIC="true"; GENERIC="false"; DEVICE_MAPPER="/dev/block/mapper"
    elif [ -d "/dev/block/by-name" ]; then
        DYNAMIC="false"; GENERIC="true"; DEVICE_MAPPER="/dev/block/by-name"
    else
        DEVICE_MAPPER="/dev/block/by-name"; GENERIC="true"
    fi

    if ls "$DEVICE_MAPPER"/*_a >/dev/null 2>&1; then
        A_B="true"; A_O="false"
    else
        A_B="false"; A_O="true"
    fi
    
    DEVICE_NAME=$(getprop ro.product.system.device)
    DEVICE_MODEL=$(getprop ro.product.system.model)
    SOC=$(getprop ro.product.board)
}

function check_root_permissions() {
    [ "$(id -u)" -eq 0 ] && ROOT=true || ROOT=false
}

function exec_as_root() {
    if [ "$ROOT" = "false" ]; then
        if command -v tsu >/dev/null 2>&1; then tsu -c "$0" "$@"; exit 0; fi
        if command -v sudo >/dev/null 2>&1; then sudo "$0" "$@"; exit 0; fi
        if command -v su >/dev/null 2>&1; then su -c "sh $0 $@"; exit 0; fi
        echo "Root access is required."
        exit 1
    fi
}

# --- Funciones de Sistema de Archivos (Core Optimizado) ---

function perform_resize_and_unshare_blocks() {
    local img="$1"
    echo "Optimizing image: $img"
    resize2fs "$img" 6G 2>$hider || echo "Warning: Fixed resize failed, trying auto..."
    e2fsck -fp "$img"
    e2fsck -E unshare_blocks "$img"
    resize2fs -M "$img"
}

function undo_resize_and_unshare_blocks() {
    local img="$image_path"
    [ ! -f "$img" ] && return 1
    echo "Reverting/Repairing image..."
    e2fsck -f "$img"
    resize2fs -M "$img"
}

function mount_device() {
    local partition="$1"
    local mount_point="$2"
    mkdir -p "$mount_point"
    
    local loop_device=$(losetup -f 2>/dev/null)
    
    if [ -n "$loop_device" ] && losetup "$loop_device" "$partition"; then
        local fs_type=$(blkid -o value -s TYPE "$loop_device")
        [ -z "$fs_type" ] && fs_type="ext4"
        
        if mount -t "$fs_type" -o rw,noatime "$loop_device" "$mount_point"; then
            echo "Mounted at $mount_point"
            prompt_for_confirmation "Press any key when finished modifying..."
            umount "$mount_point"
            losetup -d "$loop_device"
            e2fsck -f "$partition"
            resize2fs -M "$partition"
            return 0
        fi
        losetup -d "$loop_device"
    fi
    
    if mount -o rw,noatime "$partition" "$mount_point"; then
        echo "Mounted directly at $mount_point"
        prompt_for_confirmation "Press any key when finished modifying..."
        umount "$mount_point"
        e2fsck -f "$partition"
        resize2fs -M "$partition"
        return 0
    fi
    
    echo "Error: Mount failed."
    return 1
}

function extract_image_from_archive() {
    local archive="$1"
    local ext="${archive##*.}"
    local extracted_dir="$(dirname "$archive")/extracted"
    mkdir -p "$extracted_dir"
    echo "Extracting $archive..."

    case "${ext,,}" in
        zip) unzip -d "$extracted_dir" "$archive" >$hider 2>&1 ;;
        tgz|gz) tar -xzf "$archive" -C "$extracted_dir" >$hider 2>&1 ;;
        xz) xz -d -k "$archive" > "$extracted_dir/${archive%.*}" 2>$hider ;;
        tar) tar -xf "$archive" -C "$extracted_dir" >$hider 2>&1 ;;
        lz4) lz4 -d "$archive" "$extracted_dir/${archive%.*}" >$hider 2>&1 ;;
        *) echo "Generic extraction..."; 
           if command -v "extract_$ext" >/dev/null; then "extract_$ext" "$archive"; fi ;;
    esac
}

# --- Lógica de Procesamiento de Particiones (DRY) ---

function process_partitions() {
    local action="$1" # ota_rw, copy_only
    local partitions=("system" "vendor" "product" "odm")
    
    local slots=("")
    [ "$A_B" = "true" ] && slots=("_a" "_b")
    local src_suffix=""
    [ "$A_B" = "true" ] && src_suffix="_a"

    ask

    for part in "${partitions[@]}"; do
        local var_name="CUSTOM_${part^^}_NAME"
        local custom_name="${!var_name}"
        
        local target_img="/sdcard/${part}.img"
        local source_dev="${DEVICE_MAPPER}/${custom_name}${src_suffix}"

        if [ -e "$source_dev" ]; then
            echo "Copying $source_dev -> $target_img"
            dd if="$source_dev" of="$target_img" bs=32M status=none
        else
            continue 
        fi

        perform_resize_and_unshare_blocks "$target_img"

        if [ "$action" = "ota_rw" ]; then
            if [ "$A_B" = "true" ]; then
                for slot in "${slots[@]}"; do
                    local flash_target="${DEVICE_MAPPER}/${custom_name}${slot}"
                    [ -e "$flash_target" ] && dd if="$target_img" of="$flash_target" bs=32M status=none
                done
            else
                dd if="$target_img" of="${DEVICE_MAPPER}/${custom_name}" bs=32M status=none
            fi
        fi
    done
}

# --- Menús de Configuración (RESTAURADOS) ---

function save_configurations() {
    local config_file="/cache/gsirw.conf"
    [ ! -w "/cache" ] && config_file="$HOME/gsirw.conf"

    cat <<EOF > "$config_file"
CUSTOM_SYSTEM_NAME="$CUSTOM_SYSTEM_NAME"
CUSTOM_VENDOR_NAME="$CUSTOM_VENDOR_NAME"
CUSTOM_PRODUCT_NAME="$CUSTOM_PRODUCT_NAME"
CUSTOM_ODM_NAME="$CUSTOM_ODM_NAME"
MOUSE="$MOUSE"
UP_SHORTCUTS="$UP_SHORTCUTS"
A_B="$A_B"
A_O="$A_O"
DYNAMIC="$DYNAMIC"
GENERIC="$GENERIC"
DEVICE_MAPPER="$DEVICE_MAPPER"
CUSTOM_MOUNT_POINT="$CUSTOM_MOUNT_POINT"
DEFAULT_START_POINT="$DEFAULT_START_POINT"
FILE_EXTENSIONS="$FILE_EXTENSIONS"
SHORTCUTS="$SHORTCUTS"
EOF
}

function load_saved_configurations() {
    local config_files=("/cache/gsirw.conf" "$HOME/gsirw.conf")
    for f in "${config_files[@]}"; do
        if [ -f "$f" ]; then source "$f"; break; fi
    done
}

function set_partition_names() {
    clear_screen
    echo "Partition Names Configuration:"
    echo "1. System: $CUSTOM_SYSTEM_NAME"
    echo "2. Vendor: $CUSTOM_VENDOR_NAME"
    echo "3. Product: $CUSTOM_PRODUCT_NAME"
    echo "4. ODM: $CUSTOM_ODM_NAME"
    echo "5. Restore defaults"
    echo "0. Save and exit"
    read -rsn1 input
    echo ""
    case "$input" in
        1) read -p "New System Name: " CUSTOM_SYSTEM_NAME ;;
        2) read -p "New Vendor Name: " CUSTOM_VENDOR_NAME ;;
        3) read -p "New Product Name: " CUSTOM_PRODUCT_NAME ;;
        4) read -p "New ODM Name: " CUSTOM_ODM_NAME ;;
        5) CUSTOM_SYSTEM_NAME="$DEFAULT_SYSTEM_NAME"; CUSTOM_VENDOR_NAME="$DEFAULT_VENDOR_NAME"; CUSTOM_PRODUCT_NAME="$DEFAULT_PRODUCT_NAME"; CUSTOM_ODM_NAME="$DEFAULT_ODM_NAME" ;;
        0) return ;;
    esac
}

function manage_shortcuts() {
    while true; do
        clear_screen
        echo "Manage Shortcuts"
        echo "1. Create"
        echo "2. Delete"
        echo "3. List"
        echo "4. Return"
        read -rsn1 opt
        echo ""
        case $opt in
            1)
                read -p "Name: " s_name
                read -p "Path: " s_path
                if [ -d "$s_path" ]; then
                    SHORTCUTS="$SHORTCUTS
$s_name $s_path"
                fi
                ;;
            2)
                read -p "Name to delete: " s_name
                # Eliminar línea que contiene el nombre al principio
                SHORTCUTS=$(echo "$SHORTCUTS" | grep -v "^$s_name ")
                ;;
            3) echo "$SHORTCUTS"; ask ;;
            4) return ;;
        esac
    done
}

function configure_file_extensions() {
    while true; do
        clear_screen
        echo "Extensions: $FILE_EXTENSIONS"
        echo "1. Add"
        echo "2. Remove"
        echo "3. Return"
        read -rsn1 opt
        echo ""
        case $opt in
            1) read -p "Ext (no dot): " ext; FILE_EXTENSIONS="$FILE_EXTENSIONS|$ext|" ;;
            2) read -p "Ext to remove: " ext; FILE_EXTENSIONS="${FILE_EXTENSIONS/|$ext|/|}" ;;
            3) return ;;
        esac
    done
}

function configure_manually() {
    while true; do
        clear_screen
        echo "Manual Configuration:"
        echo "1. Set A/B or A Only flags"
        echo "2. Partition Parameters"
        echo "3. Mount Point ($CUSTOM_MOUNT_POINT)"
        echo "4. File Extensions"
        echo "5. Shortcuts"
        echo "6. Save & Return"
        read -rsn1 choice
        echo ""
        case $choice in
            1) 
               echo "1. A/B  2. A-Only"; read -rsn1 fl
               [ "$fl" == "1" ] && { A_B="true"; A_O="false"; }
               [ "$fl" == "2" ] && { A_B="false"; A_O="true"; }
               ;;
            2) set_partition_names ;;
            3) read -p "New Mount Point: " CUSTOM_MOUNT_POINT ;;
            4) configure_file_extensions ;;
            5) manage_shortcuts ;;
            6) save_configurations; return ;;
        esac
    done
}

function look() {
    clear_screen
    echo "Current Configuration:"
    echo "Device: $DEVICE_NAME ($DEVICE_MODEL)"
    echo "System: $CUSTOM_SYSTEM_NAME | Vendor: $CUSTOM_VENDOR_NAME"
    echo "A/B: $A_B | Mapper: $DEVICE_MAPPER"
    echo "Mount: $CUSTOM_MOUNT_POINT"
    echo "Start: $DEFAULT_START_POINT"
    echo "Exts: $FILE_EXTENSIONS"
    ask
}

# --- Explorador Interactivo (TUI Core - Ultra Rápido) ---

# Función generadora de lista (sin ls, puro bash globbing)
function generate_file_list() {
    local dir="$1"
    local index=1
    
    # Reset arrays
    dir_list=()
    
    # 1. Shortcuts (Si están habilitados arriba)
    if [ "$UP_SHORTCUTS" = "true" ]; then
        IFS=$'\n'
        for line in $SHORTCUTS; do
            local s_name=$(echo "$line" | awk '{print $1}')
            local s_path=$(echo "$line" | awk '{print $2}')
            # Validar que no sean líneas vacías
            if [[ -n "$s_name" && -n "$s_path" ]]; then
                dir_list+=("$index~[S]~$s_name~$s_path")
                ((index++))
            fi
        done
        unset IFS
    fi

    # 2. Directorios Reales
    shopt -s nullglob
    local dirs=( "$dir"/*/ )
    shopt -u nullglob
    
    for d in "${dirs[@]}"; do
        local d_name=$(basename "$d")
        dir_list+=("$index~[D]~$d_name~/")
        ((index++))
    done

    # 3. Archivos (Filtrados por extensión)
    shopt -s nullglob
    local files=( "$dir"/* )
    shopt -u nullglob

    for f in "${files[@]}"; do
        if [ -f "$f" ]; then
            local f_name=$(basename "$f")
            local ext="${f_name##*.}"
            # Chequeo rápido de string
            if [[ "$FILE_EXTENSIONS" == *"|${ext,,}|"* ]]; then
                dir_list+=("$index~[F]~$f_name~")
                ((index++))
            fi
        fi
    done
}

function interactive_core() {
    export mode="$1"
    local selected_index=1
    local image_path="$DEFAULT_START_POINT"
    [ ! -d "$image_path" ] && image_path="/sdcard"

    local needs_refresh=true
    local total_items=0

    while true; do
        # Solo regenerar la lista si cambiamos de directorio
        if [ "$needs_refresh" = true ]; then
            generate_file_list "$image_path"
            total_items=${#dir_list[@]}
            needs_refresh=false
        fi

        # Renderizado Rápido
        printf '\033[H\033[J' # Mover cursor inicio + limpiar
        echo "PATH: $image_path"
        echo "------------------------------------------------"
        echo "Navigate: W/S (Up/Down), D (Enter), A (Back), Q (Exit)"
        echo "------------------------------------------------"
        
        if [ "$total_items" -eq 0 ]; then
            echo "  (Empty Directory)"
        else
            # Imprimir ventana visible (scrolling simple)
            local start_idx=0
            local end_idx=$total_items
            
            # Bucle de impresión de items
            for item in "${dir_list[@]}"; do
                # Parsear formato: Index~[Type]~Name~Extra
                IFS='~' read -r idx type name extra <<< "$item"
                
                if [ "$idx" -eq "$selected_index" ]; then
                    printf "%s %s %s\n" "$MOUSE" "$type" "$name"
                else
                    printf "  %s %s\n" "$type" "$name"
                fi
            done
        fi

        # Input Handling (Sin delay perceptible)
        read -rsn1 input
        if [[ "$input" == $'\x1b' ]]; then
            read -rsn2 -t 0.01 input # Timeout ultra corto
            case "$input" in '[A') input="w";; '[B') input="s";; '[C') input="d";; '[D') input="a";; esac
        fi

        case "${input,,}" in
            q) break ;;
            w) ((selected_index--)); [ $selected_index -lt 1 ] && selected_index=1 ;;
            s) ((selected_index++)); [ $selected_index -gt $total_items ] && selected_index=$total_items ;;
            a) 
                image_path=$(dirname "$image_path")
                selected_index=1
                needs_refresh=true 
                ;;
            d)
                # Obtener item seleccionado del array (index base 0 vs base 1)
                local current_item="${dir_list[$((selected_index-1))]}"
                IFS='~' read -r idx type name extra <<< "$current_item"
                
                if [[ "$type" == "[D]" ]]; then
                    image_path="${image_path%/}/$name"
                    selected_index=1; needs_refresh=true
                elif [[ "$type" == "[S]" ]]; then
                    image_path="$extra"
                    selected_index=1; needs_refresh=true
                elif [[ "$type" == "[F]" ]]; then
                    select_file="$name"
                    export image_path="${image_path%/}"
                    right_logic
                    needs_refresh=true # Refrescar al volver
                fi
                ;;
        esac
    done
}

function right_logic() {
    local full_path="$image_path/$select_file"
    local ext="${select_file##*.}"
    
    echo "Selected: $select_file"
    
    if [[ "$ext" == "img" ]]; then
        ask
        case "$mode" in
            "modification"|"user_modification"|"process_user_selected_image")
                perform_resize_and_unshare_blocks "$full_path"
                [ "$mode" != "process_user_selected_image" ] && mount_device "$full_path" "$CUSTOM_MOUNT_POINT"
                ;;
            "undo") undo_resize_and_unshare_blocks ;;
            "flash") echo "Flash logic here..." ;;
        esac
    else
        # Archivo comprimido
        ask
        extract_image_from_archive "$full_path"
    fi
}

# --- Extras ---

function simulate_bootloader_patch() {
    echo -e "${NC}Generating specialized patch keys for $DEVICE_MODEL${NC}"
    sleep 2
    echo -e "${BLUE}Removing security patches...${NC}"
    echo -e "${GREEN}Success.${NC}"
    sleep 1
}

function prank() {
    clear_screen
    local width=$(get_term_width)
    local bar=$(printf '%*s' "$width" | tr ' ' '-')
    
    echo -e "${GREEN}Patching Bootloader on ${DEVICE_NAME}...${NC}"
    simulate_bootloader_patch
    echo ""
    echo -e "${RED}$bar"
    echo -e "${RED}ERROR: Critical failure.${NC}"
    echo -e "${RED}$bar"
    read -rsn1
    center_ansi "$LOGOV2"
    sleep 3
    clear_screen
}

# --- Menú Principal ---

function GSIRW() {
    clear_screen
    stty -echo
    progressive_print "$(print_justified "Initialized the great wonder created by Dark")" 0.02
    sleepy 0.5
    clear_screen
    
    center_ansi "$LOGO"
    
    progressive_print "$(print_justified "AIO (ALL IN ONE) GSI / OTA  -RW  ")" 0.1
    sleepy 0.5
    echo ""
    print_justified "1. Process User Image (File Selector)"
    print_justified "2. Process System Installed (Copy & RW)"
    print_justified "3. OTA RW (Full System)"
    print_justified "4. Modify Image (Mount)"
    print_justified "5. Undo Changes"
    print_justified "6. Manual Settings"
    print_justified "7. Check Config"
    print_justified "8. Secret ($SOC)"
    print_justified "0. Exit"
    
    echo -n "$(print_justified "Option: ")"
    stty echo
    read -rn1 option
    echo ""

    case $option in
        1) interactive_core "process_user_selected_image" ;;
        2) process_partitions "copy_only" ;;
        3) process_partitions "ota_rw" ;;
        4) interactive_core "user_modification" ;;
        5) interactive_core "undo" ;;
        6) configure_manually ;;
        7) look ;;
        8) prank ;;
        0) exit ;;
        *) GSIRW ;;
    esac
}

# --- MAIN ENTRY ---

function MAIN() {
    ANIMATION=false
    [[ "$1" == "--animation" || "$1" == "-a" ]] && { ANIMATION=true; shift; }

    default
    local call_name="$(basename "$0")"
    
    case "$call_name" in
        "gsirw_proces_image") interactive_core "process_user_selected_image" ;;
        "gsirw_sys_installed") process_partitions "copy_only" ;;
        "gsirw_ota_rw") process_partitions "ota_rw" ;;
        "gsirw") GSIRW ;;
        *) GSIRW ;;
    esac
}

function CHECK_ROOT_AND_DEPENDENCIES() {
    if [ -n "$TERMUX_VERSION" ]; then
        local missing=()
        for pkg in tsu android-tools file e2fsprogs zip unzip lz4 tar xz-utils; do
            if ! dpkg -s "$pkg" >/dev/null 2>&1; then missing+=("$pkg"); fi
        done
        if [ ${#missing[@]} -gt 0 ]; then
            echo "Installing dependencies..."
            apt update -y && apt install -y "${missing[@]}"
        fi
    fi
    check_root_permissions
    exec_as_root "$@"
}

CHECK_ROOT_AND_DEPENDENCIES "$@"
MAIN "$@"
